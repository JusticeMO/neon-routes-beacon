# Beacon environment. Copy to .env and fill in. Never commit .env.
#
# Backend: your own Supabase project (https://supabase.com) or a local stack
# from `npx supabase start` (prints the URL and anon key). Apply the schema in
# supabase/migrations with `npx supabase db push` (hosted) or `supabase db reset` (local).
# Leave these empty to run the commuter screens on sample data only.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional: Google Maps base map with the live traffic layer. Leave empty to
# use the free OpenStreetMap map. Needs the "Maps JavaScript API" enabled, and
# also enable "Directions API" so routes snap to real roads. Restrict the key to
# your site's domain in Google Cloud console.
VITE_GOOGLE_MAPS_API_KEY=

# Optional: force the demo screens (/crew, /sacco and simulated vehicles) on a
# build that has a backend configured. Without a backend, demo mode is always on.
VITE_DEMO_MODE=

# Optional: your own OSRM server for snapping routes to OpenStreetMap roads when
# no Google key is set. Optional: routes already ship following real roads.
VITE_OSRM_URL=

# Optional: "Continue with Sakafind" (sign in with Sakafind and pay fares from the
# tenant's JiPay wallet there). VITE_SAKAFIND_URL is the website (its /connect/beacon
# page), VITE_SAKAFIND_API its API ending in /api. Leave empty for a demo wallet in the
# browser where no money moves. Sakafind must list <this site>/connect/sakafind in
# BEACON_REDIRECT_URIS and this site's origin in CORS_ALLOWED_ORIGINS.
VITE_SAKAFIND_URL=
VITE_SAKAFIND_API=
