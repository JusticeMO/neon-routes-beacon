{
  "hosting": {
    "target": "beacon",
    "public": "dist",
    "ignore": ["firebase.json", "**/.*"],
    "cleanUrls": false,
    "rewrites": [
      { "source": "**", "destination": "/index.html" }
    ],
    "headers": [
      {
        "source": "/api/**",
        "headers": [
          { "key": "Access-Control-Allow-Origin", "value": "*" },
          { "key": "Cache-Control", "value": "public, max-age=300" }
        ]
      },
      {
        "source": "/sw.js",
        "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
      },
      {
        "source": "**",
        "headers": [
          {
            "key": "Content-Security-Policy",
            "value": "frame-ancestors 'self' https://sakafind.com https://www.sakafind.com https://jengasafe.com https://www.jengasafe.com https://jengasafe-9508b.web.app https://jengasafe-9508b.firebaseapp.com"
          }
        ]
      }
    ]
  }
}
